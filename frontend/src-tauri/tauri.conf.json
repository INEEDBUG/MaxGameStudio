{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MaxGameStudio",
  "version": "3.2.0-beta.1",
  "identifier": "com.cs2insightagent.app",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MaxGameStudio",
        "width": 1180,
        "height": 780,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["../../packaging/windows/app-icon.ico"],
    "resources": {
      "bundle-resources/": ""
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installerIcon": "../../packaging/windows/app-icon.ico",
        "installerHooks": "windows/upgrade-hooks.nsh",
        "template": "windows/installer.nsi",
        "installMode": "currentUser",
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNBMjcwNkFBNUIwNEJGNDgKUldSSXZ3UmJxZ1luT25TSzY2Y2M3WGhDWlpVQWVScWdKbWhqOFlGL0p5QktEVEFScERlRVRmYWIK",
      "endpoints": [
        "https://raw.githubusercontent.com/INEEDBUG/MaxGameStudio/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
