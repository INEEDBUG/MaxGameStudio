{
  "version": "3.2.0-parity",
  "cases": [
    {
      "name": "health is public",
      "method": "GET",
      "path": "/api/health",
      "headers": {},
      "body": null,
      "status": 200,
      "response_headers": {
        "content-type": "application/json"
      },
      "response_json": {
        "status": "ok",
        "version": "3.2.0-parity"
      }
    },
    {
      "name": "a desktop token does not gate health",
      "method": "GET",
      "path": "/api/health",
      "headers": {
        "X-CS2-Insight-Token": "synthetic-token"
