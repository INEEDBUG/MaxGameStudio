    },
    {
      "name": "ready guest GSI",
      "method": "POST",
      "path": "/api/gsi/cs2",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"map\":{\"name\":\"fixture_map\"},\"player\":{\"name\":\"\u73a9\u5bb6\"}}",
      "status": 200,
      "response_headers": {
        "content-type": "application/json"
      },
      "response_json": {
        "ok": true,
        "ready": true
      }
    },
    {
      "name": "guest status observes ready payload",
      "method": "GET",
      "path": "/api/gsi/status",
      "headers": {},
      "body": null,
      "status": 200,
      "response_headers": {
        "content-type": "application/json"
      },
      "response_json": {
        "ready": true,
        "last_payload_at": "<positive monotonic time>",
        "last_ready_at": "<positive monotonic time>",
        "last_payload": {
          "map": {
            "name": "fixture_map"
          },
          "player": {
            "name": "\u73a9\u5bb6"
          }
        }
      }
    },
    {
      "name": "loading payload does not reset overall readiness",
      "method": "POST",
      "path": "/api/gsi/cs2",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "{\"player\":{\"activity\":\"loading\"}}",
      "status": 200,
      "response_headers": {
        "content-type": "application/json"
      },
      "response_json": {
        "ok": true,
        "ready": false
      }
    },
    {
      "name": "status keeps the previous ready timestamp",
      "method": "GET",
      "path": "/api/gsi/status",
      "headers": {},
      "body": null,
      "status": 200,
      "response_headers": {
        "content-type": "application/json"
      },
      "response_json": {
        "ready": true,
        "last_payload_at": "<positive monotonic time>",
        "last_ready_at": "<positive monotonic time>",
        "last_payload": {
          "player": {
            "activity": "loading"
          }
        }
      }
    },
    {
