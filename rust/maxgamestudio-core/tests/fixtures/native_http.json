      "body": null,
      "status": 200,
      "response_headers": {
        "content-type": "application/json"
      },
      "response_json": {
        "status": "ok",
        "version": "3.2.0-parity"
      }
    },
    {
      "name": "empty readiness",
      "method": "GET",
      "path": "/api/gsi/status",
      "headers": {},
      "body": null,
      "status": 200,
      "response_headers": {
        "content-type": "application/json"
      },
      "response_json": {
        "ready": false,
        "last_payload_at": 0.0,
        "last_ready_at": 0.0,
        "last_payload": {}
      }
    },
    {
      "name": "empty guest GSI",
      "method": "POST",
      "path": "/api/gsi/cs2",
      "headers": {},
