    {
      "name": "explicit null is allowed",
      "method": "POST",
      "path": "/api/gsi/cs2",
      "headers": {
        "Content-Type": "application/json"
      },
      "body": "null",
      "status": 200,
      "response_headers": {
        "content-type": "application/json"
      },
      "response_json": {
        "ok": true,
        "ready": false
